{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lp-demo",
  "main": ".open-next/lp-worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Toutes les 5 minutes : rejeu des emails en attente (secret CRON_SECRET du Worker).
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "lp-demo" }],
  // Bucket à créer une fois : wrangler r2 bucket create lp-demo-opennext-cache
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "lp-demo-opennext-cache" }],
}
